{
  "id": "molion.orbitals",
  "name": "Orbitals",
  "version": "1.0.0",
  "description": "Atomic and hybrid orbitals (s, p, sp, sp², sp³, d) placed on atoms, with their phases shaded or signed.",
  "icon": "icon.svg",
  "exec": { "command": "python3", "args": ["main.py"] },
  "capabilities": ["scene:read", "scene:write"],
  "contributes": {
    "toolbar": [
      { "label": "Orbitals",
        "items": [
          { "id": "tool-s", "label": "s Orbital", "iconPath": "M10 4a6 6 0 1 0 0.01 0Z",
            "description": "Click an atom, or drag to aim.",
            "gesture": { "kind": "vector", "click": true, "prompt": "Click an atom for the s orbital" } },
          { "id": "tool-p", "label": "p Orbital",
            "iconPath": "M10 10C6 6 7 2 10 2C13 2 14 6 10 10C6 14 7 18 10 18C13 18 14 14 10 10Z",
            "description": "Click an atom, or drag to aim.",
            "gesture": { "kind": "vector", "click": true, "prompt": "Click an atom for the p orbital, or drag to aim it" } },
          { "id": "tool-sp3", "label": "sp³ Orbital",
            "iconPath": "M8 10C11 4 18 5 18 10C18 15 11 16 8 10C6 8 3 8 3 10C3 12 6 12 8 10Z",
            "description": "Click an atom, or drag to aim.",
            "gesture": { "kind": "vector", "click": true, "prompt": "Click an atom for the sp³ orbital, or drag to aim it" } },
          { "id": "tool-d", "label": "d Orbital",
            "iconPath": "M10 10C7 7 7 3 10 3C13 3 13 7 10 10C13 7 17 7 17 10C17 13 13 13 10 10C13 13 13 17 10 17C7 17 7 13 10 10C7 13 3 13 3 10C3 7 7 7 10 10Z",
            "description": "Click an atom, or drag to aim. Edit it to choose which d orbital.",
            "gesture": { "kind": "vector", "click": true, "prompt": "Click an atom for the d orbital, or drag to aim it" } }
        ] }
    ],
    "commands": [
      { "id": "place-s", "label": "Place s Orbital", "category": "Orbitals", "icon": "○", "keywords": ["orbital", "s", "sphere", "atomic"] },
      { "id": "place-p", "label": "Place p Orbital", "category": "Orbitals", "icon": "∞", "keywords": ["orbital", "p", "pi", "lobe", "atomic"] },
      { "id": "place-sp", "label": "Place sp Orbital", "category": "Orbitals", "icon": "◐", "keywords": ["orbital", "hybrid", "sp", "linear"] },
      { "id": "place-sp2", "label": "Place sp² Orbital", "category": "Orbitals", "icon": "◐", "keywords": ["orbital", "hybrid", "sp2", "trigonal"] },
      { "id": "place-sp3", "label": "Place sp³ Orbital", "category": "Orbitals", "icon": "◐", "keywords": ["orbital", "hybrid", "sp3", "tetrahedral"] },
      { "id": "place-dxy", "label": "Place dxy Orbital", "category": "Orbitals", "icon": "✣", "keywords": ["orbital", "d", "dxy", "transition metal"] },
      { "id": "place-dxz", "label": "Place dxz Orbital", "category": "Orbitals", "icon": "✣", "keywords": ["orbital", "d", "dxz", "transition metal"] },
      { "id": "place-dyz", "label": "Place dyz Orbital", "category": "Orbitals", "icon": "✣", "keywords": ["orbital", "d", "dyz", "transition metal"] },
      { "id": "place-dx2y2", "label": "Place dx²−y² Orbital", "category": "Orbitals", "icon": "✣", "keywords": ["orbital", "d", "dx2-y2", "dx2y2", "transition metal"] },
      { "id": "place-dz2", "label": "Place dz² Orbital", "category": "Orbitals", "icon": "✣", "keywords": ["orbital", "d", "dz2", "transition metal"] }
    ],
    "actions": [
      { "id": "edit", "label": "Edit Orbital…", "appliesTo": "own-image", "requirement": "Select an orbital picture first", "section": "Orbital",
        "subtitle": "Type, phase, colours and angle", "icon": "∞", "doubleClick": true },
      { "id": "flip-phase", "label": "Swap Signs", "appliesTo": "own-image", "requirement": "Select an orbital picture first", "section": "Orbital",
        "subtitle": "The positive and negative lobes change places", "icon": "±" },
      { "id": "rotate-90", "label": "Turn Orbital 90°", "appliesTo": "own-image", "requirement": "Select an orbital picture first", "section": "Orbital", "icon": "↻" }
    ],
    "templates": [
      { "name": "sp³ Hybrid Set", "scene": "templates/sp3-set.json",
        "keywords": ["orbital", "tetrahedral", "hybrid", "methane"], "description": "Four sp³ orbitals round one atom" },
      { "name": "sp² Hybrids and p", "scene": "templates/sp2-set.json",
        "keywords": ["orbital", "trigonal", "hybrid", "pi"], "description": "Three sp² orbitals, and the p orbital across them" },
      { "name": "sp Hybrids and p", "scene": "templates/sp-set.json",
        "keywords": ["orbital", "linear", "hybrid", "pi"], "description": "Two sp orbitals, and two p orbitals across them" },
      { "name": "H₂ σ Bond", "scene": "templates/h2-sigma.json",
        "keywords": ["orbital", "sigma", "overlap", "hydrogen", "bond"], "description": "Two 1s orbitals overlapping" },
      { "name": "Ethylene π Bond", "scene": "templates/ethylene-pi.json",
        "keywords": ["orbital", "pi", "alkene", "ethene", "overlap"], "description": "C=C with a p orbital on each carbon" },
      { "name": "Benzene p Orbitals", "scene": "templates/benzene-p.json",
        "keywords": ["orbital", "aromatic", "pi", "conjugation", "huckel"], "description": "The ring with a p orbital on every carbon" }
    ]
  }
}
